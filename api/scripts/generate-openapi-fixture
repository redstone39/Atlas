#!/usr/bin/env python3
"""Write the normalized Production OpenAPI contract fixture."""

from __future__ import annotations

import json
from pathlib import Path

from atlas_production.openapi_app import create_openapi_app


OUTPUT = Path(__file__).resolve().parents[1] / "tests" / "contracts" / "openapi-v1.json"


def main() -> None:
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    normalized = json.dumps(
        create_openapi_app().openapi(),
        ensure_ascii=False,
        separators=(",", ":"),
        sort_keys=True,
    )
    OUTPUT.write_text(f"{normalized}\n", encoding="utf-8")


if __name__ == "__main__":
    main()
