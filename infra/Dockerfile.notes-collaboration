FROM node:22-alpine AS builder

WORKDIR /app

COPY collaboration-server/package.json collaboration-server/package-lock.json ./
RUN npm ci

COPY collaboration-server/tsconfig.json ./
COPY collaboration-server/src ./src
RUN npm run build && npm prune --omit=dev

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder --chown=node:node /app/package.json /app/package-lock.json ./
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node infra/licenses/notes-collaboration ./licenses/notes-collaboration
COPY --from=builder --chown=node:node /app/dist ./dist
COPY --chown=node:node THIRD_PARTY_NOTICES.md ./THIRD_PARTY_NOTICES.md
COPY --chmod=755 infra/docker-entrypoint.resolve-secrets /usr/local/bin/docker-entrypoint.resolve-secrets

USER node
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.resolve-secrets"]

EXPOSE 8015

CMD ["node", "dist/main.js"]
