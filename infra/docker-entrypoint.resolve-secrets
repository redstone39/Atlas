#!/bin/sh
set -eu
has_non_whitespace() {
  case "$1" in
    *[![:space:]]*) return 0 ;;
    *) return 1 ;;
  esac
}

if ! has_non_whitespace "${ATLAS_CREDENTIAL_MASTER_KEY:-}" && [ -n "${ATLAS_CREDENTIAL_MASTER_KEY_FILE:-}" ]; then
  ATLAS_CREDENTIAL_MASTER_KEY="$(cat -- "$ATLAS_CREDENTIAL_MASTER_KEY_FILE")"
  has_non_whitespace "$ATLAS_CREDENTIAL_MASTER_KEY" || { echo "credential secret file is empty" >&2; exit 1; }
  export ATLAS_CREDENTIAL_MASTER_KEY
fi

if ! has_non_whitespace "${ATLAS_CREDENTIAL_MASTER_KEY_ID:-}" && [ -n "${ATLAS_CREDENTIAL_MASTER_KEY_ID_FILE:-}" ]; then
  ATLAS_CREDENTIAL_MASTER_KEY_ID="$(cat -- "$ATLAS_CREDENTIAL_MASTER_KEY_ID_FILE")"
  has_non_whitespace "$ATLAS_CREDENTIAL_MASTER_KEY_ID" || { echo "credential key ID file is empty" >&2; exit 1; }
  export ATLAS_CREDENTIAL_MASTER_KEY_ID
fi

if ! has_non_whitespace "${ATLAS_NOTES_COLLABORATION_INTERNAL_SECRET:-}" && [ -n "${ATLAS_NOTES_COLLABORATION_INTERNAL_SECRET_FILE:-}" ]; then
  ATLAS_NOTES_COLLABORATION_INTERNAL_SECRET="$(cat -- "$ATLAS_NOTES_COLLABORATION_INTERNAL_SECRET_FILE")"
  has_non_whitespace "$ATLAS_NOTES_COLLABORATION_INTERNAL_SECRET" || { echo "Notes transport secret file is empty" >&2; exit 1; }
  export ATLAS_NOTES_COLLABORATION_INTERNAL_SECRET
fi

if ! has_non_whitespace "${ATLAS_NOTES_COLLABORATION_TICKET_SECRET:-}" && [ -n "${ATLAS_NOTES_COLLABORATION_TICKET_SECRET_FILE:-}" ]; then
  ATLAS_NOTES_COLLABORATION_TICKET_SECRET="$(cat -- "$ATLAS_NOTES_COLLABORATION_TICKET_SECRET_FILE")"
  has_non_whitespace "$ATLAS_NOTES_COLLABORATION_TICKET_SECRET" || { echo "Notes ticket secret file is empty" >&2; exit 1; }
  export ATLAS_NOTES_COLLABORATION_TICKET_SECRET
fi

exec "$@"
