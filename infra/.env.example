# Required only while initializing an empty Identity database.
ATLAS_BOOTSTRAP_ADMIN_EMAIL=
ATLAS_BOOTSTRAP_ADMIN_PASSWORD=

# Required before storing Provider credentials in System Admin.
ATLAS_CREDENTIAL_MASTER_KEY=
ATLAS_CREDENTIAL_MASTER_KEY_ID=
# Optional JSON map of retained key IDs to base64 keys for credential rotation.
ATLAS_CREDENTIAL_MASTER_KEYRING=
