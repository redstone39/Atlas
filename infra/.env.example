# Optional deployment-secret overrides. A fresh Compose deployment generates
# and persists these values in dedicated named volumes when they are absent.
# Provide the credential key and key ID together; retain every override for as
# long as the encrypted data or Notes deployment must remain usable.
ATLAS_CREDENTIAL_MASTER_KEY=
ATLAS_CREDENTIAL_MASTER_KEY_ID=

# When overriding the Notes secrets, generate two distinct random values.
ATLAS_NOTES_COLLABORATION_INTERNAL_SECRET=
ATLAS_NOTES_COLLABORATION_TICKET_SECRET=
# Optional browser-reachable WebSocket endpoint and loopback host port.
# ATLAS_NOTES_COLLABORATION_PUBLIC_URL=ws://127.0.0.1:8015/collaboration
# ATLAS_PRODUCTION_COLLABORATION_PORT=8015

# Optional MCP public origin or exact /mcp URL for an operator-managed proxy.
# Leave empty for the supported localhost-only Host/Origin policy. This input
# does not configure TLS, expose a port, or make the snapshot Internet Ready.
# ATLAS_MCP_PUBLIC_URL=https://atlas.example/mcp
