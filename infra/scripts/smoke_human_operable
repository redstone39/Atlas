#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/../.."

: "${ATLAS_PRODUCTION_SMOKE_PROVIDER_API_KEY:?Set the Provider key that browser automation will enter through the setup UI.}"
: "${ATLAS_HUMAN_SMOKE_ADMIN_EMAIL:?Set the fresh-database administrator email.}"
: "${ATLAS_HUMAN_SMOKE_ADMIN_PASSWORD:?Set a fresh-database administrator password of at least 12 characters.}"

if (( ${#ATLAS_HUMAN_SMOKE_ADMIN_PASSWORD} < 12 )); then
  echo "ATLAS_HUMAN_SMOKE_ADMIN_PASSWORD must contain at least 12 characters." >&2
  exit 1
fi
if [[ -n "${ATLAS_PRODUCTION_PROVIDER_ENDPOINT+x}" && -z "$ATLAS_PRODUCTION_PROVIDER_ENDPOINT" ]]; then
  echo "ATLAS_PRODUCTION_PROVIDER_ENDPOINT must not be empty when set." >&2
  exit 1
fi
if [[ -n "${ATLAS_PRODUCTION_PROVIDER_MODEL+x}" && -z "$ATLAS_PRODUCTION_PROVIDER_MODEL" ]]; then
  echo "ATLAS_PRODUCTION_PROVIDER_MODEL must not be empty when set." >&2
  exit 1
fi
if [[ -n "${CHROME_EXECUTABLE_PATH+x}" && ! -x "$CHROME_EXECUTABLE_PATH" ]]; then
  echo "CHROME_EXECUTABLE_PATH must name an executable file when set." >&2
  exit 1
fi

node infra/scripts/browser_smoke_human_operable.mjs
