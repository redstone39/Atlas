#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/../.."

project_name="${ATLAS_PRODUCTION_COMPOSE_PROJECT:-atlas-production-p2-rbac-smoke}"
api_url="http://127.0.0.1:${ATLAS_PRODUCTION_API_PORT:-8012}"
web_url="http://127.0.0.1:${ATLAS_PRODUCTION_WEB_PORT:-5184}"
cookie_file="$(mktemp)"
user_cookie_file="$(mktemp)"
web_cookie_file="$(mktemp)"
web_login_headers="$(mktemp)"
web_session_file="$(mktemp)"
web_anonymous_session_file="$(mktemp)"
fixture_file="$(mktemp)"
original_head_body="$(mktemp)"
original_get_body="$(mktemp)"
suffix="$(date +%s)"
admin_email="smoke-admin-${suffix}@example.test"
admin_password="SmokeBootstrap-${suffix}!"
user_email="rbac-smoke-${suffix}@example.test"
project_name_label="P2 RBAC Smoke ${suffix}"

compose() {
  docker compose -p "$project_name" -f infra/docker-compose.p1.yml "$@"
}

cleanup() {
  rm -f \
    "$cookie_file" \
    "$user_cookie_file" \
    "$web_cookie_file" \
    "$web_login_headers" \
    "$web_session_file" \
    "$web_anonymous_session_file" \
    "$fixture_file" \
    "$original_head_body" \
    "$original_get_body"
  compose down -v --remove-orphans >/dev/null 2>&1 || true
}
trap cleanup EXIT

wait_for_url() {
  local name="$1"
  local url="$2"
  for _ in {1..90}; do
    if curl -fsS "$url" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  echo "Timed out waiting for $name at $url" >&2
  compose logs >&2 || true
  return 1
}

json_field() {
  python3 -c 'import json,sys; data=json.load(sys.stdin); path=sys.argv[1].split(".");
value=data
for key in path:
    value=value[int(key)] if key.isdigit() else value[key]
print(value)' "$1"
}

admin_login_json() {
  python3 -c 'import json,sys; print(json.dumps({
"identifier": sys.argv[1],
"password": sys.argv[2],
}))' "$admin_email" "$admin_password"
}

first_admin_claim_json() {
  python3 -c 'import json,sys; print(json.dumps({
"display_name": "P2 RBAC Smoke Admin",
"email": sys.argv[1],
"password": sys.argv[2],
}))' "$admin_email" "$admin_password"
}

api_get() {
  local path="$1"
  curl -fsS -b "$cookie_file" -c "$cookie_file" "${api_url}${path}"
}

api_post() {
  local path="$1"
  local body="$2"
  curl -fsS -b "$cookie_file" -c "$cookie_file" \
    -H "Content-Type: application/json" \
    -X POST \
    --data "$body" \
    "${api_url}${path}"
}

user_api_post() {
  local path="$1"
  local body="$2"
  curl -fsS -b "$user_cookie_file" -c "$user_cookie_file" \
    -H "Content-Type: application/json" \
    -X POST \
    --data "$body" \
    "${api_url}${path}"
}

user_document_visible() {
  curl -fsS -b "$user_cookie_file" "${api_url}/api/v1/library/documents" \
    | python3 -c 'import json,sys; document_id=sys.argv[1]; data=json.load(sys.stdin); print("True" if any(item["document_id"] == document_id for item in data["documents"]) else "False")' \
      "$document_id"
}

latest_decision_source() {
  compose exec -T postgres psql -U atlas -d atlas_production -tAc \
    "select coalesce(source_id, '') from atlas_access_decisions where actor_id = '${actor_id}' and project_id = '${project_id}' and action = 'workspace_query' order by created_at desc, decision_id desc limit 1;" \
    | tr -d '[:space:]'
}

compose up --build -d

wait_for_url "production API" "${api_url}/api/v1/ops/health"
wait_for_url "production Web" "${web_url}/login"

first_admin="$(api_get "/api/v1/auth/first-admin")"
if [[ "$(printf '%s' "$first_admin" | json_field claim_available)" != "True" ]]; then
  echo "Fresh P2 stack did not offer the first-administrator claim" >&2
  exit 1
fi
claim_response="$(
  curl -sS --fail-with-body -b "$cookie_file" -c "$cookie_file" \
    -H "Content-Type: application/json" \
    -X POST \
    --data "$(first_admin_claim_json)" \
    "${api_url}/api/v1/auth/first-admin" \
    -w $'\n%{http_code}'
)"
if [[ "${claim_response##*$'\n'}" != "201" ]]; then
  echo "P2 first-administrator claim failed with HTTP ${claim_response##*$'\n'}" >&2
  exit 1
fi

web_login_status="$(
  curl -sS \
    -D "$web_login_headers" \
    -o "$web_session_file" \
    -b "$web_cookie_file" \
    -c "$web_cookie_file" \
    -H "Content-Type: application/json" \
    -X POST \
    --data "$(admin_login_json)" \
    -w '%{http_code}' \
    "${web_url}/api/v1/auth/sessions"
)"
if [[ "$web_login_status" != "200" ]]; then
  echo "Web-origin bootstrap admin login failed with HTTP ${web_login_status}" >&2
  exit 1
fi
python3 - "$web_login_headers" "$web_session_file" <<'PY'
import json
import pathlib
import sys

headers = pathlib.Path(sys.argv[1]).read_text(encoding="utf-8").lower()
session = json.loads(pathlib.Path(sys.argv[2]).read_text(encoding="utf-8"))
if (
    "set-cookie: atlas_session=" not in headers
    or "httponly" not in headers
    or "samesite=lax" not in headers
):
    raise SystemExit("Web-origin login did not return the required session cookie attributes")
if not session.get("authenticated"):
    raise SystemExit("Web-origin login did not return an authenticated session")
PY

curl -fsS \
  -b "$web_cookie_file" \
  -c "$web_cookie_file" \
  "${web_url}/api/v1/auth/session" \
  | python3 -c 'import json,sys; data=json.load(sys.stdin); raise SystemExit(0 if data.get("authenticated") else 1)'

web_logout_status="$(
  curl -sS \
    -o /dev/null \
    -b "$web_cookie_file" \
    -c "$web_cookie_file" \
    -X DELETE \
    -w '%{http_code}' \
    "${web_url}/api/v1/auth/session"
)"
if [[ "$web_logout_status" != "204" ]]; then
  echo "Web-origin logout failed with HTTP ${web_logout_status}" >&2
  exit 1
fi
curl -fsS \
  -o "$web_anonymous_session_file" \
  -b "$web_cookie_file" \
  -c "$web_cookie_file" \
  "${web_url}/api/v1/auth/session"
python3 - "$web_anonymous_session_file" <<'PY'
import json
import pathlib
import sys

session = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
if session.get("authenticated") or session.get("actor") is not None:
    raise SystemExit("Web-origin logout did not restore an anonymous session")
PY

curl -fsS \
  -b "$web_cookie_file" \
  -c "$web_cookie_file" \
  -H "Content-Type: application/json" \
  -X POST \
  --data "$(admin_login_json)" \
  "${web_url}/api/v1/auth/sessions" >/dev/null

api_post "/api/v1/auth/sessions" \
  "$(admin_login_json)" >/dev/null

invite="$(
  api_post "/api/v1/admin/user-invites" \
    "{\"display_name\":\"RBAC Smoke User\",\"email\":\"${user_email}\",\"system_role\":\"user\",\"idempotency_key\":\"invite-${suffix}\"}"
)"
actor_id="$(printf '%s' "$invite" | json_field invite.actor_id)"
invite_token="$(printf '%s' "$invite" | json_field local_pilot_acceptance.acceptance_token)"

api_post "/api/v1/auth/invitations/accept" \
  "{\"invite_token\":\"${invite_token}\",\"password\":\"AtlasLocalEngineer!01\",\"idempotency_key\":\"accept-${suffix}\"}" >/dev/null

project="$(
  api_post "/api/v1/admin/projects" \
    "{\"name\":\"${project_name_label}\",\"policy_profile_id\":\"policy-default-governed\",\"idempotency_key\":\"project-${suffix}\"}"
)"
project_ref="$(printf '%s' "$project" | json_field target_ref)"
if [[ "$project_ref" != project:* ]]; then
  echo "P2 project owner returned an invalid target_ref" >&2
  exit 1
fi
project_id="${project_ref#project:}"

printf 'Atlas contextual RBAC smoke fixture.\n' >"$fixture_file"
upload="$(
  curl -fsS -b "$cookie_file" -c "$cookie_file" \
    -F "scope_type=project" \
    -F "scope_id=${project_id}" \
    -F "allow_member_download=true" \
    -F "idempotency_key=upload-${suffix}" \
    -F "file=@${fixture_file};filename=rbac-smoke.txt;type=text/plain" \
    "${api_url}/api/v1/admin/document-library"
)"
document_id="$(printf '%s' "$upload" | json_field document.document_id)"
status_url="$(printf '%s' "$upload" | json_field status_url)"
document_status=""
for _ in {1..90}; do
  document_status="$(
    curl -fsS -b "$cookie_file" "${api_url}${status_url}" | json_field status
  )"
  if [[ "$document_status" == "ready" || "$document_status" == "ready_with_warnings" ]]; then
    break
  fi
  if [[ "$document_status" == "failed" ]]; then
    echo "RBAC smoke document processing failed" >&2
    exit 1
  fi
  sleep 1
done
if [[ "$document_status" != "ready" && "$document_status" != "ready_with_warnings" ]]; then
  echo "RBAC smoke document processing did not become ready" >&2
  exit 1
fi

original_url="${web_url}/api/v1/library/documents/${document_id}/content"
original_head_status="$(
  curl -sS \
    -o "$original_head_body" \
    -b "$web_cookie_file" \
    -X HEAD \
    -w '%{http_code}' \
    "$original_url"
)"
original_get_status="$(
  curl -sS \
    -o "$original_get_body" \
    -b "$web_cookie_file" \
    -w '%{http_code}' \
    "$original_url"
)"
if [[ "$original_head_status" != "200" || "$original_get_status" != "200" ]]; then
  echo "Original document HEAD/GET failed through the Web origin" >&2
  exit 1
fi
python3 - "$fixture_file" "$original_head_body" "$original_get_body" <<'PY'
import hashlib
import pathlib
import sys

fixture = pathlib.Path(sys.argv[1]).read_bytes()
head_body = pathlib.Path(sys.argv[2]).read_bytes()
get_body = pathlib.Path(sys.argv[3]).read_bytes()
expected_length = len(fixture)
expected_digest = hashlib.sha256(fixture).hexdigest()
if head_body:
    raise SystemExit("Original document HEAD returned a response body")
if len(get_body) != expected_length:
    raise SystemExit("Original document GET returned the wrong byte length")
if hashlib.sha256(get_body).hexdigest() != expected_digest:
    raise SystemExit("Original document GET returned the wrong SHA-256")
PY

user_api_post "/api/v1/auth/sessions" \
  "{\"identifier\":\"${user_email}\",\"password\":\"AtlasLocalEngineer!01\"}" >/dev/null

parent_team="$(
  api_post "/api/v1/admin/teams" \
    "{\"name\":\"Parent ${suffix}\",\"parent_team_id\":null,\"idempotency_key\":\"team-parent-${suffix}\"}"
)"
parent_team_ref="$(printf '%s' "$parent_team" | json_field target_ref)"
if [[ "$parent_team_ref" != team:* ]]; then
  echo "P2 parent team owner returned an invalid target_ref" >&2
  exit 1
fi
parent_team_id="${parent_team_ref#team:}"
child_team="$(
  api_post "/api/v1/admin/teams" \
    "{\"name\":\"Child ${suffix}\",\"parent_team_id\":\"${parent_team_id}\",\"idempotency_key\":\"team-child-${suffix}\"}"
)"
child_team_ref="$(printf '%s' "$child_team" | json_field target_ref)"
if [[ "$child_team_ref" != team:* ]]; then
  echo "P2 child team owner returned an invalid target_ref" >&2
  exit 1
fi
child_team_id="${child_team_ref#team:}"
api_post "/api/v1/admin/teams/${child_team_id}/members" \
  "{\"member_actor_type\":\"user\",\"member_actor_id\":\"${actor_id}\",\"role\":\"admin\",\"idempotency_key\":\"team-member-${suffix}\"}" >/dev/null

api_post "/api/v1/admin/projects/${project_id}/members" \
  "{\"subject_type\":\"team\",\"subject_id\":\"${parent_team_id}\",\"role\":\"admin\",\"effect\":\"deny\",\"idempotency_key\":\"grant-parent-deny-${suffix}\"}" >/dev/null
api_post "/api/v1/admin/projects/${project_id}/members" \
  "{\"subject_type\":\"team\",\"subject_id\":\"${child_team_id}\",\"role\":\"viewer\",\"effect\":\"allow\",\"idempotency_key\":\"grant-child-allow-${suffix}\"}" >/dev/null

if [[ "$(user_document_visible)" != "True" ]]; then
  echo "Child team allow did not override parent team deny for workspace query" >&2
  exit 1
fi
if [[ "$(latest_decision_source)" != "grant-project-access-${project_id}-team-${child_team_id}" ]]; then
  echo "The document-library read did not record the child team grant as the winning source" >&2
  exit 1
fi

api_post "/api/v1/admin/projects/${project_id}/members" \
  "{\"subject_type\":\"team\",\"subject_id\":\"${child_team_id}\",\"role\":\"viewer\",\"effect\":\"deny\",\"idempotency_key\":\"grant-child-deny-${suffix}\"}" >/dev/null
if [[ "$(user_document_visible)" != "False" ]]; then
  echo "Same-tier deny did not override child team allow" >&2
  exit 1
fi

api_post "/api/v1/admin/projects/${project_id}/members" \
  "{\"subject_type\":\"user\",\"subject_id\":\"${actor_id}\",\"role\":\"viewer\",\"effect\":\"allow\",\"idempotency_key\":\"grant-direct-allow-${suffix}\"}" >/dev/null
if [[ "$(user_document_visible)" != "True" ]]; then
  echo "Direct user grant did not override team deny" >&2
  exit 1
fi
if [[ "$(latest_decision_source)" != "grant-project-access-${project_id}-user-${actor_id}" ]]; then
  echo "The document-library read did not record the direct grant as the winning source" >&2
  exit 1
fi

schema_version="$(
  compose exec -T postgres psql -U atlas -d atlas_production -tAc \
    "select version_num from alembic_version;" \
    | tr -d '[:space:]'
)"
expected_schema_version="$(
  python3 - <<'PY'
import ast
from pathlib import Path

revisions = set()
down_revisions = set()
for path in Path("api/src/atlas_production/migrations/versions").glob("*.py"):
    tree = ast.parse(path.read_text(encoding="utf-8"))
    values = {}
    for node in tree.body:
        if isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name):
            if node.target.id in {"revision", "down_revision"}:
                values[node.target.id] = ast.literal_eval(node.value)
    revisions.add(values["revision"])
    down_revision = values.get("down_revision")
    if isinstance(down_revision, str):
        down_revisions.add(down_revision)
    elif down_revision:
        down_revisions.update(down_revision)
heads = revisions - down_revisions
if len(heads) != 1:
    raise SystemExit(f"Expected one Alembic head, found {sorted(heads)}")
print(heads.pop())
PY
)"
if [[ "$schema_version" != "$expected_schema_version" ]]; then
  echo "PostgreSQL schema version did not reach the current migration head" >&2
  exit 1
fi

team_count="$(
  compose exec -T postgres psql -U atlas -d atlas_production -tAc \
    "select count(*) from atlas_teams where team_id in ('${parent_team_id}', '${child_team_id}');" \
    | tr -d '[:space:]'
)"
grant_count="$(
  compose exec -T postgres psql -U atlas -d atlas_production -tAc \
    "select count(*) from atlas_permission_grants where project_id = '${project_id}' and status = 'active';" \
    | tr -d '[:space:]'
)"
decision_count="$(
  compose exec -T postgres psql -U atlas -d atlas_production -tAc \
    "select count(*) from atlas_access_decisions where project_id = '${project_id}';" \
    | tr -d '[:space:]'
)"
if [[ "$team_count" != "2" || "$grant_count" -lt "4" || "$decision_count" -lt "4" ]]; then
  echo "Structured RBAC tables did not persist expected runtime data" >&2
  exit 1
fi

compose restart api >/dev/null
wait_for_url "restarted production API" "${api_url}/api/v1/ops/health"

api_post "/api/v1/auth/sessions" \
  "$(admin_login_json)" >/dev/null

user_api_post "/api/v1/auth/sessions" \
  "{\"identifier\":\"${user_email}\",\"password\":\"AtlasLocalEngineer!01\"}" >/dev/null

if [[ "$(user_document_visible)" != "True" ]]; then
  echo "Persisted direct user grant was not effective after API restart" >&2
  exit 1
fi

users="$(api_get "/api/v1/admin/users")"
if ! printf '%s' "$users" | grep -Fq "$actor_id"; then
  echo "Persisted user was not found after API restart" >&2
  exit 1
fi
if printf '%s' "$users" | grep -Fq "$invite_token"; then
  echo "Invite token leaked from admin users list" >&2
  exit 1
fi
if printf '%s' "$users" | grep -Eq "password_digest|token_digest|invite_token_digest"; then
  echo "Secret digest field leaked from admin users list" >&2
  exit 1
fi
