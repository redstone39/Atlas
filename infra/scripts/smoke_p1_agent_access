#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/../.."

project_name="${ATLAS_PRODUCTION_COMPOSE_PROJECT:-atlas-production-p1-smoke}"
api_url="http://127.0.0.1:${ATLAS_PRODUCTION_API_PORT:-8012}"
web_url="http://127.0.0.1:${ATLAS_PRODUCTION_WEB_PORT:-5184}"
cookie_file="$(mktemp)"
mcp_header_file="$(mktemp)"
suffix="$(date +%s)"
admin_email="smoke-admin-${suffix}@example.test"
admin_password="SmokeBootstrap-${suffix}!"
agent_name="P1 Smoke Agent ${suffix}"
legacy_snapshot_table="atlas_""production_snapshots"
legacy_membership_table="atlas_""memberships"
legacy_query_table="atlas_""queries"
legacy_citation_table="atlas_""citation_projects"
export ATLAS_CREDENTIAL_MASTER_KEY="${ATLAS_CREDENTIAL_MASTER_KEY:-$(openssl rand -base64 32)}"
export ATLAS_CREDENTIAL_MASTER_KEY_ID="${ATLAS_CREDENTIAL_MASTER_KEY_ID:-p1-smoke-${suffix}}"

compose() {
  docker compose -p "$project_name" -f infra/docker-compose.p1.yml "$@"
}

cleanup() {
  rm -f "$cookie_file" "$mcp_header_file"
  compose down -v --remove-orphans >/dev/null 2>&1 || true
}
trap cleanup EXIT

wait_for_url() {
  local name="$1"
  local url="$2"
  for _ in {1..90}; do
    if curl -fsS "$url" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  echo "Timed out waiting for $name at $url" >&2
  compose logs >&2 || true
  return 1
}

json_field() {
  python3 -c 'import json,sys; data=json.load(sys.stdin); path=sys.argv[1].split(".");
value=data
for key in path:
    value=value[int(key)] if key.isdigit() else value[key]
print(value)' "$1"
}

sse_json_field() {
  python3 -c 'import json,sys
path=sys.argv[1].split(".")
line=next(line[6:] for line in sys.stdin.read().splitlines() if line.startswith("data: "))
value=json.JSONDecoder().raw_decode(line)[0]
for key in path:
    value=value[int(key)] if key.isdigit() else value[key]
print(value)' "$1"
}

mcp_initialize_json() {
  python3 -c 'import json; print(json.dumps({
"jsonrpc": "2.0",
"id": 1,
"method": "initialize",
"params": {
    "protocolVersion": "2025-06-18",
    "capabilities": {},
    "clientInfo": {"name": "atlas-public-smoke", "version": "1.0"},
},
}))'
}

mcp_tools_list_json() {
  python3 -c 'import json; print(json.dumps({
"jsonrpc": "2.0", "id": 2, "method": "tools/list", "params": {},
}))'
}

mcp_scope_list_json() {
  python3 -c 'import json; print(json.dumps({
"jsonrpc": "2.0",
"id": 3,
"method": "tools/call",
"params": {"name": "atlas.list_knowledge_scopes", "arguments": {"limit": 50}},
}))'
}

mcp_research_json() {
  python3 -c 'import json,sys; print(json.dumps({
"jsonrpc": "2.0",
"id": 4,
"method": "tools/call",
"params": {
    "name": "atlas.research",
    "arguments": {
        "question": "Verify the selected public smoke scope",
        "idempotency_key": "smoke-agent-research-after-revoke",
        "scope": {"mode": "selected", "refs": [{"kind": "project", "id": sys.argv[1]}]},
        "output_mode": "evidence_packet",
    },
},
}))' "$project_id"
}

mcp_session_id() {
  python3 -c 'import sys
for line in open(sys.argv[1], encoding="utf-8"):
    name, separator, value = line.partition(":")
    if separator and name.lower() == "mcp-session-id":
        print(value.strip())
        break' "$mcp_header_file"
}

admin_login_json() {
  python3 -c 'import json,sys; print(json.dumps({
"identifier": sys.argv[1],
"password": sys.argv[2],
}))' "$admin_email" "$admin_password"
}

first_admin_claim_json() {
  python3 -c 'import json,sys; print(json.dumps({
"display_name": "P1 Smoke Admin",
"email": sys.argv[1],
"password": sys.argv[2],
}))' "$admin_email" "$admin_password"
}

api_post() {
  local path="$1"
  local body="$2"
  curl -fsS -b "$cookie_file" -c "$cookie_file" \
    -H "Content-Type: application/json" \
    -X POST \
    --data "$body" \
    "${api_url}${path}"
}

api_delete() {
  local path="$1"
  curl -fsS -b "$cookie_file" -c "$cookie_file" \
    -H "Content-Type: application/json" \
    -X DELETE \
    "${api_url}${path}"
}

compose down -v --remove-orphans >/dev/null 2>&1 || true
compose up --build -d

wait_for_url "production API" "${api_url}/api/v1/ops/health"
wait_for_url "production Web" "${web_url}/login"

first_admin="$(curl -fsS "${api_url}/api/v1/auth/first-admin")"
if [[ "$(printf '%s' "$first_admin" | json_field claim_available)" != "True" ]]; then
  echo "Fresh P1 stack did not offer the first-administrator claim" >&2
  exit 1
fi
claim_response="$(
  curl -sS --fail-with-body -b "$cookie_file" -c "$cookie_file" \
    -H "Content-Type: application/json" \
    -X POST \
    --data "$(first_admin_claim_json)" \
    "${api_url}/api/v1/auth/first-admin" \
    -w $'\n%{http_code}'
)"
if [[ "${claim_response##*$'\n'}" != "201" ]]; then
  echo "P1 first-administrator claim failed with HTTP ${claim_response##*$'\n'}" >&2
  exit 1
fi

project="$(
  api_post "/api/v1/admin/projects" \
    '{"name":"P1 Smoke Project","policy_profile_id":"policy-default-governed","idempotency_key":"smoke-project"}'
)"
project_ref="$(printf '%s' "$project" | json_field target_ref)"
if [[ "$project_ref" != project:* ]]; then
  echo "P1 project owner returned an invalid target_ref" >&2
  exit 1
fi
project_id="${project_ref#project:}"

agent="$(
  api_post "/api/v1/admin/agent-users" \
    "{\"display_name\":\"${agent_name}\",\"idempotency_key\":\"smoke-agent\"}"
)"
agent_id="$(printf '%s' "$agent" | json_field agent.actor_id)"
grant_id="grant-project-access-${project_id}-service_account-${agent_id}"

issued="$(
  api_post "/api/v1/admin/agent-users/${agent_id}/tokens" \
    '{"idempotency_key":"smoke-token"}'
)"
raw_token="$(printf '%s' "$issued" | json_field raw_token)"
fingerprint="$(printf '%s' "$issued" | json_field token.token_fingerprint)"

api_post "/api/v1/admin/projects/${project_id}/members" \
  "{\"subject_type\":\"service_account\",\"subject_id\":\"${agent_id}\",\"role\":\"viewer\",\"effect\":\"allow\",\"idempotency_key\":\"smoke-agent-project-access\"}" >/dev/null

schema_version="$(
  compose exec -T postgres psql -U atlas -d atlas_production -tAc \
    "select version_num from alembic_version;" \
    | tr -d '[:space:]'
)"
expected_schema_version="$(
  python3 - <<'PY'
import ast
from pathlib import Path

revisions = set()
down_revisions = set()
for path in Path("api/src/atlas_production/migrations/versions").glob("*.py"):
    tree = ast.parse(path.read_text(encoding="utf-8"))
    values = {}
    for node in tree.body:
        if isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name):
            if node.target.id in {"revision", "down_revision"}:
                values[node.target.id] = ast.literal_eval(node.value)
    revisions.add(values["revision"])
    down_revision = values.get("down_revision")
    if isinstance(down_revision, str):
        down_revisions.add(down_revision)
    elif down_revision:
        down_revisions.update(down_revision)
heads = revisions - down_revisions
if len(heads) != 1:
    raise SystemExit(f"Expected one Alembic head, found {sorted(heads)}")
print(heads.pop())
PY
)"
if [[ "$schema_version" != "$expected_schema_version" ]]; then
  echo "PostgreSQL schema version was not controlled by Alembic" >&2
  exit 1
fi
structured_agent_count="$(
  compose exec -T postgres psql -U atlas -d atlas_production -tAc \
    "select count(*) from atlas_users where actor_id = '${agent_id}' and actor_type = 'service_account';" \
    | tr -d '[:space:]'
)"
structured_token_count="$(
  compose exec -T postgres psql -U atlas -d atlas_production -tAc \
    "select count(*) from atlas_agent_tokens where actor_id = '${agent_id}' and token_fingerprint = '${fingerprint}';" \
    | tr -d '[:space:]'
)"
structured_grant_count="$(
  compose exec -T postgres psql -U atlas -d atlas_production -tAc \
    "select count(*) from atlas_permission_grants where grant_id = '${grant_id}' and status = 'active' and effect = 'allow';" \
    | tr -d '[:space:]'
)"
legacy_table_count="$(
  compose exec -T postgres psql -U atlas -d atlas_production -tAc \
    "select count(*) from (values ('${legacy_snapshot_table}'),('${legacy_membership_table}'),('${legacy_query_table}'),('${legacy_citation_table}')) as legacy(name) where to_regclass('public.' || name) is not null;" \
    | tr -d '[:space:]'
)"
if [[ "$structured_agent_count" != "1" || "$structured_token_count" != "1" || "$structured_grant_count" != "1" ]]; then
  echo "Structured PostgreSQL tables did not persist P1 runtime data" >&2
  exit 1
fi
if [[ "$legacy_table_count" != "0" ]]; then
  echo "Legacy compatibility tables must not exist in the development baseline" >&2
  exit 1
fi

compose restart api >/dev/null
wait_for_url "restarted production API" "${api_url}/api/v1/ops/health"

api_post "/api/v1/auth/sessions" \
  "$(admin_login_json)" >/dev/null

agents="$(curl -fsS -b "$cookie_file" "${api_url}/api/v1/admin/agent-users")"
if ! printf '%s' "$agents" | grep -Fq "$agent_id"; then
  echo "Persisted agent was not found after API restart" >&2
  exit 1
fi
if ! printf '%s' "$agents" | grep -Fq "$fingerprint"; then
  echo "Persisted token fingerprint was not found after API restart" >&2
  exit 1
fi
if printf '%s' "$agents" | grep -Fq "$raw_token"; then
  echo "Raw token leaked from agent list after API restart" >&2
  exit 1
fi
if printf '%s' "$agents" | grep -Fq "token_digest"; then
  echo "Token digest leaked from agent list after API restart" >&2
  exit 1
fi

legacy_response="$(
  curl -sS -H "Authorization: Bearer ${raw_token}" \
    -H "Content-Type: application/json" \
    -X POST \
    --data "{\"project_id\":\"${project_id}\",\"query_text\":\"P1 smoke\",\"purpose\":\"local smoke\",\"idempotency_key\":\"smoke-agent-query\"}" \
    "${api_url}/api/v1/agent/queries" \
    -w $'\n%{http_code}'
)"
if [[ "${legacy_response##*$'\n'}" != "404" ]]; then
  echo "Legacy Agent query route did not return 404" >&2
  exit 1
fi

initialize_payload="$(mcp_initialize_json)"
missing_bearer_response="$(
  curl -sS \
    -H "Accept: application/json, text/event-stream" \
    -H "Content-Type: application/json" \
    -X POST \
    --data "$initialize_payload" \
    "${api_url}/mcp" \
    -w $'\n%{http_code}'
)"
if [[ "${missing_bearer_response##*$'\n'}" != "401" ]]; then
  echo "MCP initialize without a bearer did not return 401" >&2
  exit 1
fi

initialize_response="$(
  curl -sS -D "$mcp_header_file" \
    -H "Authorization: Bearer ${raw_token}" \
    -H "Accept: application/json, text/event-stream" \
    -H "Content-Type: application/json" \
    -X POST \
    --data "$initialize_payload" \
    "${api_url}/mcp"
)"
session_id="$(mcp_session_id)"
if [[ -z "$session_id" || "$(printf '%s' "$initialize_response" | sse_json_field result.protocolVersion)" != "2025-06-18" ]]; then
  echo "Valid opaque Agent bearer did not initialize exact /mcp" >&2
  exit 1
fi

tools_response="$(
  curl -fsS \
    -H "Authorization: Bearer ${raw_token}" \
    -H "Accept: application/json, text/event-stream" \
    -H "Content-Type: application/json" \
    -H "MCP-Session-Id: ${session_id}" \
    -H "MCP-Protocol-Version: 2025-06-18" \
    -X POST \
    --data "$(mcp_tools_list_json)" \
    "${api_url}/mcp"
)"
tool_names="$(
  printf '%s' "$tools_response" | python3 -c 'import json,sys
line=next(line[6:] for line in sys.stdin.read().splitlines() if line.startswith("data: "))
payload=json.JSONDecoder().raw_decode(line)[0]
print("|".join(sorted(tool["name"] for tool in payload["result"]["tools"])))'
)"
if [[ "$tool_names" != "atlas.get_research|atlas.list_knowledge_scopes|atlas.read_evidence|atlas.research" ]]; then
  echo "MCP did not expose the exact four public Agent research tools" >&2
  exit 1
fi

api_delete "/api/v1/admin/projects/${project_id}/members/${grant_id}" >/dev/null

scope_response="$(
  curl -fsS \
    -H "Authorization: Bearer ${raw_token}" \
    -H "Accept: application/json, text/event-stream" \
    -H "Content-Type: application/json" \
    -H "MCP-Session-Id: ${session_id}" \
    -H "MCP-Protocol-Version: 2025-06-18" \
    -X POST \
    --data "$(mcp_scope_list_json)" \
    "${api_url}/mcp"
)"
if printf '%s' "$scope_response" | grep -Fq "$project_id"; then
  echo "Revoked Project grant remained visible in current MCP scope discovery" >&2
  exit 1
fi

research_response="$(
  curl -fsS \
    -H "Authorization: Bearer ${raw_token}" \
    -H "Accept: application/json, text/event-stream" \
    -H "Content-Type: application/json" \
    -H "MCP-Session-Id: ${session_id}" \
    -H "MCP-Protocol-Version: 2025-06-18" \
    -X POST \
    --data "$(mcp_research_json)" \
    "${api_url}/mcp"
)"
if [[ "$(printf '%s' "$research_response" | sse_json_field result.isError)" != "True" ]] || \
  ! printf '%s' "$research_response" | grep -Fq "agent_research_scope_denied"; then
  echo "Revoked Project grant did not fail closed for MCP research" >&2
  exit 1
fi
