#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[2]
DENIED_PREFIXES = (
    "plans/",
    ".atlas-benchmark/",
    "uploads/",
    "artifacts/",
    "dumps/",
    "exports/",
)
DENIED_COMPONENTS = {
    ".cache",
    ".env",
    ".mypy_cache",
    ".next",
    ".pytest_cache",
    ".ruff_cache",
    ".turbo",
    ".venv",
    ".vite",
    "__pycache__",
    "build",
    "caches",
    "coverage",
    "deployment-overrides",
    "dist",
    "journey-bank",
    "logs",
    "node_modules",
    "out",
    "private",
    "snapshots",
    "target",
    "venv",
}
BASELINE_PUBLIC_FIXTURES = {
    "api/tests/fixtures/__init__.py",
    "api/tests/fixtures/local_pilot.py",
    "plugin-sdk/examples/atlas-docling-pdf/fixtures/smoke-input.json",
    "plugin-sdk/examples/atlas-pypdf/fixtures/smoke-input.json",
}
PRIVATE_PATH = re.compile(rb"/(?:Users|home)/[^/\s]+/")
SECRET_LITERAL = re.compile(
    rb"(?:sk-[A-Za-z0-9_-]{20,}|gh[opusr]_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----)"
)
DIRECT_PAYLOAD_PATH = re.compile(
    r"(?:^|/)(?:conversation|turn|provider|model)[-_]?(?:exports?|payloads?|dumps?)(?:/|$)",
    re.IGNORECASE,
)
DIRECT_PAYLOAD_LITERAL = re.compile(
    rb"""(?ixs)
    ["']?\b(?:conversation|turn|provider|model)[_-]?(?:payload|content|text|response)
    \b["']?\s*(?:=|:)\s*[rubf]*["'][^"'\r\n]+["']
    |
    (?<![a-z0-9_.])["']?\btranscript\b["']?\s*(?:=|:)\s*[rubf]*["'][^"'\r\n]+["']
    |
    ["']role["']\s*:\s*["'](?:user|assistant|system|developer|tool|function|provider|model)["'].{0,4096}?
    ["'](?:content|message|text)["']\s*:\s*["'][^"'\r\n]+["']
    |
    ["'](?:content|message|text)["']\s*:\s*["'][^"'\r\n]+["'].{0,4096}?
    ["']role["']\s*:\s*["'](?:user|assistant|system|developer|tool|function|provider|model)["']
    """
)
SAFE_DIRECT_PAYLOAD_MARKER = re.compile(
    rb"(?i)(?:^|[^a-z0-9])(?:public-synthetic|SENSITIVE_[A-Z0-9_]*MARKER|example|fixture|dummy|fake|placeholder|redacted)(?:[^a-z0-9]|$)"
)
SECRET_ASSIGNMENT = re.compile(
    rb"""(?ix)
    (?<![-/])\b(?:api[_-]?key|access[_-]?token|auth[_-]?token|token|password|passwd|secret|credential)
    \b\s*(?:=|:)\s*(?:[rubf]*["']([^"'\r\n]{8,})["']|((?=[A-Za-z0-9_+/=-]{8,}\s*(?:[,;}\]\r\n]|$))(?=[A-Za-z0-9_+/=-]*(?:[-+/=]|\d))[A-Za-z0-9_+/=-]{8,}))
    """
)
SAFE_CREDENTIAL_MARKER = re.compile(
    rb"""(?ix)
    (?:^|[^a-z0-9])(?:public-synthetic|example|test|testloginpassword|fixture|
    dummy|fake|placeholder|redacted|canary|rotated-secret|too-short|
    short-secret|directory-password|bind-secret|session-|do-not-log|
    not-a-real|changeme|localhost)(?:[^a-z0-9]|$)
    """
)


def _git(*args: str) -> bytes:
    return subprocess.check_output(["git", *args], cwd=REPO_ROOT)


def _parse_changes(raw: bytes) -> list[tuple[str, str, bool]]:
    fields = raw.split(b"\0")
    changes: list[tuple[str, str, bool]] = []
    index = 0
    while index < len(fields) and fields[index]:
        status = fields[index].decode("ascii")
        index += 1
        if status.startswith(("R", "C")):
            old_path = fields[index].decode("utf-8")
            new_path = fields[index + 1].decode("utf-8")
            index += 2
            changes.extend(((status, old_path, True), (status, new_path, False)))
            continue
        path = fields[index].decode("utf-8")
        index += 1
        changes.append((status, path, status.startswith("D")))
    return changes


def _changes(committed: bool, base_ref: str | None) -> list[tuple[str, str, bool]]:
    if committed and base_ref is None:
        paths = _git("ls-tree", "-r", "--name-only", "-z", "HEAD").split(b"\0")
        return [("A", path.decode("utf-8"), False) for path in paths if path]
    args = ["diff"]
    if not committed:
        args.append("--cached")
    args.extend(("--name-status", "-z", "--find-renames"))
    if committed:
        args.append(f"{base_ref}..HEAD")
    return _parse_changes(_git(*args))


def _blob(path: str, committed: bool) -> bytes:
    revision = f"HEAD:{path}" if committed else f":{path}"
    return _git("show", revision)


def _denied_path(path: str) -> str | None:
    normalized = path.replace("\\", "/")
    if normalized.startswith(DENIED_PREFIXES):
        return "denied publication path"
    components = set(normalized.split("/"))
    if (
        components.intersection(DENIED_COMPONENTS)
        or ("fixtures" in components and normalized not in BASELINE_PUBLIC_FIXTURES)
    ):
        return "denied private, fixture, cache, or build path"
    basename = normalized.rsplit("/", 1)[-1]
    if basename.startswith(".env") and basename != ".env.example":
        return "denied environment path"
    if DIRECT_PAYLOAD_PATH.search(normalized):
        return "denied direct runtime payload path"
    return None


def _is_decodable_text(path: str, blob: bytes) -> bool:
    if "\0" in blob[:8192].decode("utf-8", errors="ignore"):
        return False
    try:
        blob.decode("utf-8")
    except UnicodeDecodeError:
        return False
    return True

def _contains_direct_json_payload(blob: bytes) -> bool:
    try:
        value = json.loads(blob)
    except (UnicodeDecodeError, json.JSONDecodeError):
        return False

    def visit(item: object) -> bool:
        if isinstance(item, dict):
            role = item.get("role")
            if isinstance(role, str) and role.lower() in {
                "user",
                "assistant",
                "system",
                "developer",
                "tool",
                "function",
                "provider",
                "model",
            }:
                for key in ("content", "message", "text"):
                    payload = item.get(key)
                    if payload not in (None, "", [], {}):
                        encoded = json.dumps(
                            payload,
                            ensure_ascii=False,
                            sort_keys=True,
                        ).encode()
                        if SAFE_DIRECT_PAYLOAD_MARKER.search(encoded) is None:
                            return True
            return any(visit(child) for child in item.values())
        if isinstance(item, list):
            return any(visit(child) for child in item)
        return False

    return visit(value)


def _load_allowed_paths(source: str) -> set[str]:
    path = Path(source)
    if not path.is_file():
        raise RuntimeError("allowed paths manifest is missing or unreadable")
    values = [line.strip() for line in path.read_text(encoding="utf-8").splitlines()]
    values = [value for value in values if value]
    if not values:
        raise RuntimeError("allowed paths manifest is empty")
    if len(values) != len(set(values)):
        raise RuntimeError("allowed paths manifest contains duplicate paths")
    if any(
        value.startswith(("/", "../"))
        or "\\" in value
        or "/../" in value
        or value.endswith("/..")
        for value in values
    ):
        raise RuntimeError("allowed paths manifest contains an invalid path")
    return set(values)


def _load_sensitive_hashes(required: bool) -> set[str]:
    source = os.environ.get("ATLAS_PRIVATE_SENSITIVE_HASH_FILE")
    if not source:
        if required:
            raise RuntimeError(
                "ATLAS_PRIVATE_SENSITIVE_HASH_FILE is required in manifest mode"
            )
        return set()
    path = Path(source)
    if not path.is_file():
        raise RuntimeError("private sensitive hash input is missing or unreadable")
    values = {
        line.strip().lower()
        for line in path.read_text(encoding="utf-8").splitlines()
        if line.strip()
    }
    if not values:
        raise RuntimeError("private sensitive hash input is empty")
    invalid = [value for value in values if not re.fullmatch(r"[0-9a-f]{64}", value)]
    if invalid:
        raise RuntimeError("private sensitive hash input contains an invalid SHA-256")
    return values


def _validate_manifest(
    changed_paths: set[str], allowed_paths: set[str], require_exact: bool
) -> list[tuple[str, str]]:
    findings = [
        (path, "changed path is absent from allowed paths manifest")
        for path in sorted(changed_paths - allowed_paths)
    ]
    if require_exact:
        findings.extend(
            (path, "allowed path is absent from baseline-to-HEAD changes")
            for path in sorted(allowed_paths - changed_paths)
        )
    return findings


def _scan(path: str, blob: bytes, sensitive_hashes: set[str]) -> list[str]:
    findings: list[str] = []
    denied = _denied_path(path)
    if denied is not None:
        findings.append(denied)
    if PRIVATE_PATH.search(blob):
        findings.append("absolute private workstation path")
    if SECRET_LITERAL.search(blob):
        findings.append("literal credential or private key")
    if any(
        SAFE_CREDENTIAL_MARKER.search(match.group(1) or match.group(2)) is None
        for match in SECRET_ASSIGNMENT.finditer(blob)
    ):
        findings.append("hard-coded credential assignment")
    if _is_decodable_text(path, blob) and (
        _contains_direct_json_payload(blob)
        or any(
            SAFE_DIRECT_PAYLOAD_MARKER.search(match.group(0)) is None
            for match in DIRECT_PAYLOAD_LITERAL.finditer(blob)
        )
    ):
        findings.append("direct conversation or Provider payload literal")
    if sensitive_hashes and hashlib.sha256(blob).hexdigest() in sensitive_hashes:
        findings.append("private sensitive blob hash overlap")
    return findings


def _self_test() -> None:
    digest = hashlib.sha256(b"private-sensitive-fixture").hexdigest()
    cases = (
        ("plans/private-plan.yaml", b"safe", set(), "denied publication path"),
        (
            "web/.next/server/app.js",
            b"generated",
            set(),
            "denied private, fixture, cache, or build path",
        ),
        (
            "api/tests/fixtures/customer.json",
            b"{}",
            set(),
            "denied private, fixture, cache, or build path",
        ),
        (
            "src/example.txt",
            b"/" + b"Users/example/" + b"Library/Mobile Documents/private/file",
            set(),
            "absolute private workstation path",
        ),
        (
            "src/example.txt",
            b"/" + b"Users/example/workspace/private-repository/source.py",
            set(),
            "absolute private workstation path",
        ),
        (
            "src/example.txt",
            b"/" + b"home/alice/private-repository.txt",
            set(),
            "absolute private workstation path",
        ),
        (
            "src/example.txt",
            b"token=" + b"sk-" + b"abcdefghijklmnopqrstuvwxyz012345",
            set(),
            "literal credential or private key",
        ),
        (
            "docs/private.md",
            b"private-sensitive-fixture",
            {digest},
            "private sensitive blob hash overlap",
        ),
        (
            "api/tests/test_private_behavior.py",
            b"private-sensitive-fixture",
            {digest},
            "private sensitive blob hash overlap",
        ),
        (
            "conversation-exports/turns.json",
            b"{}",
            set(),
            "denied direct runtime payload path",
        ),
        (
            "api/src/ordinary.py",
            b'trans' + b'cript = "customer private message"',
            set(),
            "direct conversation or Provider payload literal",
        ),
        (
            "docs/ordinary.md",
            b'provider_' + b'response: "customer private message"',
            set(),
            "direct conversation or Provider payload literal",
        ),
        (
            "config/ordinary.json",
            b'{"model_' + b'payload": "customer private message"}',
            set(),
            "direct conversation or Provider payload literal",
        ),
        (
            "config/ordinary.json",
            b'{"mes' + b'sages":[{"ro' + b'le":"user","con' + b'tent":"customer private message"}]}',
            set(),
            "direct conversation or Provider payload literal",
        ),
        (
            "config/long-transcript.json",
            b'{"mes'
            + b'sages":[{"ro'
            + b'le":"system","con'
            + b'tent":"'
            + b"x" * 600
            + b'"},{"ro'
            + b'le":"user","con'
            + b'tent":"customer private message"}]}',
            set(),
            "direct conversation or Provider payload literal",
        ),
        (
            "config/assistant-output.json",
            b'{"ro' + b'le":"assistant","mes' + b'sage":"customer answer"}',
            set(),
            "direct conversation or Provider payload literal",
        ),
        (
            "config/provider-output.json",
            b'{"ro' + b'le":"provider","te' + b'xt":"customer completion"}',
            set(),
            "direct conversation or Provider payload literal",
        ),
        (
            "config/system-prompt.json",
            b'{"ro' + b'le":"system","con' + b'tent":"customer policy prompt"}',
            set(),
            "direct conversation or Provider payload literal",
        ),
        (
            "config/tool-output.json",
            b'{"ro' + b'le":"tool","con' + b'tent":"customer tool result"}',
            set(),
            "direct conversation or Provider payload literal",
        ),
        (
            "src/example.py",
            b"to"
            + b'ken = "public-synthetic-token"\ncre'
            + b'dential = "customer-production-credential"',
            set(),
            "hard-coded credential assignment",
        ),
        (
            "src/example.py",
            b"cre" + b"dential = production-credential-value",
            set(),
            "hard-coded credential assignment",
        ),
    )
    for path, blob, hashes, expected in cases:
        findings = _scan(path, blob, hashes)
        if expected not in findings:
            raise RuntimeError(
                f"boundary self-test did not reject {expected}: {path}"
            )

    safe_cases = (
        ("api/src/public.py", b"public-safe"),
        (
            "api/tests/test_public_behavior.py",
            b'transcript = "public-synthetic example transcript"',
        ),
        (
            "contracts/user-messages.json",
            b'{"message_code":"conversation_payload_required","default_message":"example"}',
        ),
        (
            "api/tests/test_public_messages.py",
            b'{"mes' + b'sages":[{"ro' + b'le":"user","con' + b'tent":"public-synthetic example"}]}',
        ),
        (
            "api/tests/test_provider_messages.py",
            b'{"messages":[{"role":"system","content":"Return public-synthetic structured output."},{"role":"user","content":"Answer the public-synthetic example."}]}',
        ),
        (
            "api/tests/test_assistant_context.py",
            b'{"role":"assistant","content_segments":[{"kind":"text","text":"public-synthetic-x"}]}',
        ),
    )
    for path, blob in safe_cases:
        if _scan(path, blob, set()):
            raise RuntimeError(f"boundary self-test rejected safe public content: {path}")

    if not _validate_manifest({"changed.py"}, {"allowed.py"}, False):
        raise RuntimeError("boundary self-test accepted a manifest extra path")
    missing = _validate_manifest({"changed.py"}, {"changed.py", "missing.py"}, True)
    if ("missing.py", "allowed path is absent from baseline-to-HEAD changes") not in missing:
        raise RuntimeError("boundary self-test accepted a missing exact-manifest path")

    prior_hash_file = os.environ.pop("ATLAS_PRIVATE_SENSITIVE_HASH_FILE", None)
    try:
        try:
            _load_sensitive_hashes(required=True)
        except RuntimeError as exc:
            if "is required" not in str(exc):
                raise
        else:
            raise RuntimeError("boundary self-test accepted missing private hash input")
    finally:
        if prior_hash_file is not None:
            os.environ["ATLAS_PRIVATE_SENSITIVE_HASH_FILE"] = prior_hash_file
    print("public snapshot boundary self-test passed")


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Audit the staged index or baseline-to-HEAD public boundary."
    )
    parser.add_argument("--committed", action="store_true")
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument("--base-ref")
    parser.add_argument("--allowed-paths-file")
    parser.add_argument("--require-exact-manifest", action="store_true")
    args = parser.parse_args()
    if args.self_test:
        _self_test()
        return 0

    manifest_mode = bool(
        args.base_ref or args.allowed_paths_file or args.require_exact_manifest
    )
    try:
        if manifest_mode and not (args.base_ref and args.allowed_paths_file):
            raise RuntimeError(
                "manifest mode requires --base-ref and --allowed-paths-file"
            )
        if args.require_exact_manifest and not args.committed:
            raise RuntimeError("--require-exact-manifest requires --committed")
        if args.base_ref:
            _git("rev-parse", "--verify", f"{args.base_ref}^{{commit}}")

        sensitive_hashes = _load_sensitive_hashes(required=manifest_mode)
        allowed_paths = (
            _load_allowed_paths(args.allowed_paths_file)
            if args.allowed_paths_file
            else None
        )
        changes = _changes(args.committed, args.base_ref)
        changed_paths = {path for _, path, _ in changes}
        findings: list[tuple[str, str]] = []
        if allowed_paths is not None:
            findings.extend(
                _validate_manifest(
                    changed_paths, allowed_paths, args.require_exact_manifest
                )
            )
        scanned: set[str] = set()
        for _, path, deleted in changes:
            if deleted or path in scanned:
                continue
            scanned.add(path)
            for finding in _scan(path, _blob(path, args.committed), sensitive_hashes):
                findings.append((path, finding))
    except (OSError, RuntimeError, subprocess.CalledProcessError, UnicodeError) as exc:
        print(f"public snapshot boundary error: {exc}", file=sys.stderr)
        return 2

    if findings:
        for path, finding in findings:
            print(f"{path}: {finding}", file=sys.stderr)
        return 1
    mode = "committed" if args.committed else "staged"
    manifest_note = " with manifest" if allowed_paths is not None else ""
    hash_note = " and private hash input" if sensitive_hashes else ""
    print(
        f"public snapshot boundary passed: {mode} {len(changed_paths)} paths"
        f"{manifest_note}{hash_note}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
