#!/usr/bin/env python3
from __future__ import annotations

import json
import os
from pathlib import Path
import subprocess
import sys


ROOT = Path(__file__).resolve().parents[2]
COMPOSE = ROOT / "infra" / "docker-compose.portainer-smb.yml"
REQUIRED = {
    "ATLAS_SMB_HOST": "smb.example.internal",
    "ATLAS_SMB_SHARE": "atlas",
    "ATLAS_SMB_SUBDIR": "artifacts",
    "ATLAS_SMB_USERNAME": "atlas-operator",
    "ATLAS_SMB_PASSWORD": "audit-dummy-password",
    "ATLAS_SMB_GENERATION": "7",
    "ATLAS_ARTIFACT_SWITCH_MODE": "operator_accepted_unverified",
    "ATLAS_ARTIFACT_SWITCH_ACK": "I_ACCEPT_UNVERIFIED_BLOB_MAPPING_AND_CONTENT",
}
SECRET_OVERRIDE_NAMES = {
    "ATLAS_CREDENTIAL_MASTER_KEY",
    "ATLAS_CREDENTIAL_MASTER_KEY_ID",
    "ATLAS_NOTES_COLLABORATION_INTERNAL_SECRET",
    "ATLAS_NOTES_COLLABORATION_TICKET_SECRET",
}
OPERATOR_PROXY_INPUTS = {"HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY"}
LOWERCASE_PROXY_INPUTS = {"http_proxy", "https_proxy", "no_proxy"}
ALL_PROXY_INPUTS = OPERATOR_PROXY_INPUTS | LOWERCASE_PROXY_INPUTS
PROXY_CONSUMERS = {"api", "celery-processing"}
INTERNAL_NO_PROXY = (
    "::1,127.0.0.1,localhost,postgres,redis,qdrant,"
    "plugin-runner,office-renderer,notes-collaboration,api,web"
)
LEGACY_PROXY_ENVIRONMENT = "ATLAS_AZURE_PROXY_URL"


def resolve(environment: dict[str, str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [
            "docker",
            "compose",
            "-f",
            str(COMPOSE),
            "config",
            "--format",
            "json",
        ],
        cwd=ROOT,
        env=environment,
        text=True,
        capture_output=True,
        check=False,
    )


def fail(message: str) -> None:
    print(f"portainer SMB compose audit failed: {message}", file=sys.stderr)
    raise SystemExit(1)


environment = dict(os.environ)
for name in ALL_PROXY_INPUTS | SECRET_OVERRIDE_NAMES:
    environment.pop(name, None)
environment.update(REQUIRED)
resolved = resolve(environment)
if resolved.returncode != 0:
    fail("Compose could not resolve with the documented variables")
model = json.loads(resolved.stdout)
if model.get("name") != "atlas-production-p1":
    fail("Compose project identity is not atlas-production-p1")
services = model["services"]
api = services.get("api", {})
carrier = services.get("notes-collaboration", {})
initializer = services.get("deployment-secret-init", {})
if not carrier:
    fail("Notes collaboration carrier service is missing")
if not initializer:
    fail("deployment secret initializer service is missing")
if initializer.get("restart") not in (None, "no"):
    fail("deployment secret initializer is restartable")
if not initializer.get("read_only"):
    fail("deployment secret initializer root filesystem is writable")
if initializer.get("security_opt") != ["no-new-privileges:true"]:
    fail("deployment secret initializer lacks no-new-privileges")

api_environment = api.get("environment", {})
carrier_environment = carrier.get("environment", {})
for name in SECRET_OVERRIDE_NAMES:
    if initializer.get("environment", {}).get(name) != "":
        fail(f"no-env fallback did not resolve for {name}")

direct_environment_consumers = {
    name: {
        service_name
        for service_name, service in services.items()
        if name in service.get("environment", {})
    }
    for name in SECRET_OVERRIDE_NAMES
}
if direct_environment_consumers["ATLAS_CREDENTIAL_MASTER_KEY"] != {
    "deployment-secret-init",
    "api",
    "celery-processing",
}:
    fail("credential key environment reachability drifted")
if direct_environment_consumers[
    "ATLAS_CREDENTIAL_MASTER_KEY_ID"
] != direct_environment_consumers["ATLAS_CREDENTIAL_MASTER_KEY"]:
    fail("credential key pair environment reachability differs")
if direct_environment_consumers["ATLAS_NOTES_COLLABORATION_INTERNAL_SECRET"] != {
    "deployment-secret-init",
    "api",
    "notes-collaboration",
}:
    fail("Notes transport environment reachability drifted")
if direct_environment_consumers["ATLAS_NOTES_COLLABORATION_TICKET_SECRET"] != {
    "deployment-secret-init",
    "api",
}:
    fail("Notes ticket environment reachability drifted")

secret_volume_consumers = {
    volume: {
        name
        for name, service in services.items()
        if any(
            mount.get("source") == volume
            for mount in service.get("volumes", [])
        )
    }
    for volume in (
        "atlas-production-credential-secrets",
        "atlas-production-notes-transport-secret",
        "atlas-production-notes-ticket-secret",
    )
}
if secret_volume_consumers["atlas-production-credential-secrets"] != {
    "deployment-secret-init",
    "api",
    "celery-processing",
}:
    fail("credential projection reachability drifted")
if secret_volume_consumers["atlas-production-notes-transport-secret"] != {
    "deployment-secret-init",
    "api",
    "notes-collaboration",
}:
    fail("Notes transport projection reachability drifted")
if secret_volume_consumers["atlas-production-notes-ticket-secret"] != {
    "deployment-secret-init",
    "api",
}:
    fail("Notes ticket projection reachability drifted")
for volume, consumers in secret_volume_consumers.items():
    for name in consumers - {"deployment-secret-init"}:
        mount = next(
            item
            for item in services[name].get("volumes", [])
            if item.get("source") == volume
        )
        if not mount.get("read_only", False):
            fail(f"runtime secret projection {volume} is writable by {name}")

if api_environment.get("ATLAS_NOTES_COLLABORATION_INTERNAL_URL") != (
    "http://notes-collaboration:8015"
):
    fail("API does not address the internal Notes carrier")
if carrier_environment.get("ATLAS_NOTES_COLLABORATION_INTERNAL_URL") != (
    "http://api:8002"
):
    fail("Notes carrier does not address the API authority")
if "ATLAS_NOTES_COLLABORATION_PUBLIC_URL" in carrier_environment:
    fail("public WebSocket configuration leaked into the carrier")
if not carrier.get("read_only"):
    fail("Notes carrier root filesystem is writable")
if carrier.get("depends_on", {}).get("api", {}).get("condition") != (
    "service_healthy"
):
    fail("Notes carrier does not wait for API health")
if "notes-collaboration" in api.get("depends_on", {}):
    fail("API depends on the carrier and creates a dependency cycle")
carrier_ports = carrier.get("ports", [])
if len(carrier_ports) != 1 or carrier_ports[0].get("host_ip") != "127.0.0.1":
    fail("Notes WebSocket host port is not loopback-only")
if (
    carrier_ports[0].get("target") != 8015
    or carrier_ports[0].get("published") != "8015"
):
    fail("Notes carrier port mapping drifted")
health_test = " ".join(carrier.get("healthcheck", {}).get("test", []))
if (
    "/ready" not in health_test
    or "ATLAS_NOTES_COLLABORATION_INTERNAL_SECRET" not in health_test
):
    fail("Notes carrier healthcheck does not exercise authenticated readiness")

secret_gated = {
    name
    for name, service in services.items()
    if service.get("depends_on", {})
    .get("deployment-secret-init", {})
    .get("condition")
    == "service_completed_successfully"
}
if secret_gated != {"api", "celery-processing", "notes-collaboration"}:
    fail("secret consumers are not gated on initializer success")

override_environment = dict(environment)
override_environment.update(
    {
        "ATLAS_CREDENTIAL_MASTER_KEY": "BQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQU=",
        "ATLAS_CREDENTIAL_MASTER_KEY_ID": "audit-key-id",
        "ATLAS_NOTES_COLLABORATION_INTERNAL_SECRET": "audit-transport-override",
        "ATLAS_NOTES_COLLABORATION_TICKET_SECRET": "audit-ticket-override",
    }
)
override_resolved = resolve(override_environment)
if override_resolved.returncode != 0:
    fail("Compose could not resolve complete secret overrides")
override_services = json.loads(override_resolved.stdout)["services"]
for name, consumers in direct_environment_consumers.items():
    for service_name in consumers:
        if (
            override_services[service_name]["environment"].get(name)
            != override_environment[name]
        ):
            fail(f"complete override did not reach {service_name} for {name}")

for name, service in services.items():
    service_environment = service.get("environment", {})
    if LEGACY_PROXY_ENVIRONMENT in service_environment:
        fail(f"legacy Azure proxy setting remains in service {name}")
    if LOWERCASE_PROXY_INPUTS & set(service_environment):
        fail(f"lowercase proxy environment leaked into service {name}")
    if name in PROXY_CONSUMERS:
        if service_environment.get("HTTPS_PROXY") != "":
            fail(f"{name} did not preserve direct HTTPS behavior by default")
        if service_environment.get("HTTP_PROXY") != "":
            fail(f"{name} did not preserve direct HTTP behavior by default")
        if service_environment.get("NO_PROXY") != f"{INTERNAL_NO_PROXY},":
            fail(f"{name} is missing the mandatory internal NO_PROXY prefix")
    elif OPERATOR_PROXY_INPUTS & set(service_environment):
        fail(f"standard proxy setting leaked into unrelated service {name}")

lowercase_environment = dict(environment)
lowercase_environment.update({
    "http_proxy": "http://lower-http-proxy.example:8080",
    "https_proxy": "http://lower-https-proxy.example:8443",
    "no_proxy": "lowercase.example",
})
lowercase_resolved = resolve(lowercase_environment)
if lowercase_resolved.returncode != 0:
    fail("Compose could not resolve while lowercase host proxy variables were present")
lowercase_services = json.loads(lowercase_resolved.stdout)["services"]
for name in PROXY_CONSUMERS:
    service_environment = lowercase_services[name]["environment"]
    if service_environment.get("HTTPS_PROXY") != "":
        fail(f"{name} accepted lowercase HTTPS proxy compatibility")
    if service_environment.get("HTTP_PROXY") != "":
        fail(f"{name} accepted lowercase HTTP proxy compatibility")
    if service_environment.get("NO_PROXY") != f"{INTERNAL_NO_PROXY},":
        fail(f"{name} accepted lowercase NO_PROXY compatibility")

uppercase_environment = dict(lowercase_environment)
uppercase_environment.update({
    "HTTP_PROXY": "http://upper-http-proxy.example:8080",
    "HTTPS_PROXY": "http://upper-https-proxy.example:8443",
    "NO_PROXY": "operator.example",
})
uppercase_resolved = resolve(uppercase_environment)
if uppercase_resolved.returncode != 0:
    fail("Compose could not resolve uppercase optional proxy inputs")
uppercase_services = json.loads(uppercase_resolved.stdout)["services"]
for name in PROXY_CONSUMERS:
    service_environment = uppercase_services[name]["environment"]
    if service_environment.get("HTTP_PROXY") != uppercase_environment["HTTP_PROXY"]:
        fail(f"{name} did not map uppercase HTTP_PROXY")
    if service_environment.get("HTTPS_PROXY") != uppercase_environment["HTTPS_PROXY"]:
        fail(f"{name} did not map uppercase HTTPS_PROXY")
    expected_no_proxy = f"{INTERNAL_NO_PROXY},{uppercase_environment['NO_PROXY']}"
    if service_environment.get("NO_PROXY") != expected_no_proxy:
        fail(f"{name} did not preserve and extend the mandatory NO_PROXY prefix")

if json.loads(uppercase_resolved.stdout)["volumes"]["atlas-production-artifacts"] != model[
    "volumes"
]["atlas-production-artifacts"]:
    fail("proxy-only configuration changed SMB volume identity or DriverOpts")

artifact_consumers = {
    name
    for name, service in services.items()
    if any(
        mount.get("source") == "atlas-production-artifacts"
        for mount in service.get("volumes", [])
    )
}
expected_consumers = {
    "api",
    "artifact-storage-init",
    "celery-processing",
    "celery-maintenance",
}
if artifact_consumers != expected_consumers:
    fail("artifact volume consumer set drifted")

expected_artifact_gated = expected_consumers - {"artifact-storage-init"}
expected_gated = expected_artifact_gated | {
    "celery-dispatch",
    "celery-indexing",
}
gated = {
    name
    for name, service in services.items()
    if service.get("depends_on", {})
    .get("artifact-storage-init", {})
    .get("condition")
    == "service_completed_successfully"
}
if gated != expected_gated:
    fail("artifact consumers are not gated on initializer success")

smb_coordinates = {
    "ATLAS_SMB_HOST",
    "ATLAS_SMB_SHARE",
    "ATLAS_SMB_SUBDIR",
    "ATLAS_SMB_USERNAME",
    "ATLAS_SMB_DOMAIN",
    "ATLAS_SMB_VERSION",
}
if any("ATLAS_SMB_PASSWORD" in service.get("environment", {}) for service in services.values()):
    fail("SMB password leaked into a service environment")
for name, service in services.items():
    exposed = smb_coordinates & set(service.get("environment", {}))
    if name == "artifact-storage-init":
        if exposed != smb_coordinates:
            fail("initializer is missing non-secret SMB validation inputs")
    elif exposed:
        fail("SMB coordinates leaked into a long-running service environment")

config_mounts = {
    name: next(
        (
            mount
            for mount in service.get("volumes", [])
            if mount.get("source") == "atlas-production-artifact-config"
        ),
        None,
    )
    for name, service in services.items()
}
if config_mounts["artifact-storage-init"] is None or config_mounts[
    "artifact-storage-init"
].get("read_only", False):
    fail("initializer must receive the artifact config volume read-write")
for name in expected_artifact_gated:
    mount = config_mounts[name]
    if mount is None or not mount.get("read_only", False):
        fail("artifact consumers must receive the artifact config volume read-only")

volume = model["volumes"]["atlas-production-artifacts"]
if volume.get("name") != "atlas-production-smb-g7":
    fail("generation did not control the immutable volume name")
if volume.get("driver") != "local" or volume.get("driver_opts", {}).get("type") != "cifs":
    fail("artifact volume is not a local CIFS volume")

missing_environment = dict(os.environ)
for name in REQUIRED:
    missing_environment.pop(name, None)
missing = resolve(missing_environment)
if missing.returncode == 0:
    fail("Compose accepted a deployment with required variables missing")

print("portainer SMB compose audit passed")
